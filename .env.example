# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED VARIABLES (Set via `bunx hardhat vars setup`)
# =============================================================================

# BIP-39 mnemonic for account generation (12 or 24 words)
# This should be set using: bunx hardhat vars set MNEMONIC
# MNEMONIC="your twelve word mnemonic phrase here for account derivation and signing"

# OR use a single deployer private key instead of mnemonic
# This should be set using: bunx hardhat vars set DEPLOYER_PRIVATE_KEY
# DEPLOYER_PRIVATE_KEY="0x1234567890abcdef..." # Your deployer's private key

# Infura API key for supported networks (Ethereum, Polygon, Arbitrum, etc.)
# Get from: https://infura.io/
# This should be set using: bunx hardhat vars set INFURA_API_KEY
# INFURA_API_KEY="your_infura_api_key_here"

# =============================================================================
# NETWORK FORKING CONFIGURATION
# =============================================================================

# Set to 'true' to enable network forking (requires CHAIN_ID)
# Set to 'false' or leave unset for pure Hardhat local node (default)
ENABLE_FORKING=false

# Chain ID to fork when ENABLE_FORKING=true
# Supported values: 1, 137, 11155111, 31337, 1337
# Examples:
# CHAIN_ID=1        # Fork Ethereum Mainnet
# CHAIN_ID=137      # Fork Polygon Mainnet
# CHAIN_ID=11155111 # Fork Sepolia Testnet
CHAIN_ID=

# =============================================================================
# OPTIONAL ETHERSCAN API KEYS
# =============================================================================

# Etherscan V2 Unified API Key
# Works for Ethereum, Polygon, Sepolia, and other supported chains
# Get from: https://etherscan.io/apis
# ETHERSCAN_API_KEY="your_etherscan_v2_api_key"

# Note: With Etherscan V2, you only need ONE API key for multiple chains!
# Supported chains: Ethereum Mainnet, Polygon Mainnet, Sepolia Testnet
# More chains being added to Etherscan V2 regularly

# =============================================================================
# OPTIONAL DEVELOPMENT SETTINGS
# =============================================================================

# Set to any value to enable gas reporting during tests
# REPORT_GAS=true

# =============================================================================
# USAGE EXAMPLES
# =============================================================================

# Pure Hardhat (local development - default):
# bunx hardhat test

# Fork Ethereum Mainnet for testing:
# ENABLE_FORKING=true CHAIN_ID=1 bunx hardhat test

# Fork Polygon Mainnet for testing:
# ENABLE_FORKING=true CHAIN_ID=137 bunx hardhat test

# Deploy to Sepolia Testnet:
# bunx hardhat deploy --network sepolia

# Run against Polygon Mainnet:
# bunx hardhat run scripts/example.ts --network polygon-mainnet

# =============================================================================
# SECURITY NOTES
# =============================================================================

# NEVER commit .env files to version control
# Use `bunx hardhat vars setup` for sensitive values (MNEMONIC, API keys)
# The vars system encrypts sensitive data locally
# Only use test mnemonics/accounts for development