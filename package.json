{
  "name": "@prb/hardhat-template",
  "description": "Hardhat-based template for developing Solidity smart contracts",
  "version": "1.0.0",
  "type": "module",
  "author": {
    "name": "Paul Razvan Berg",
    "url": "https://github.com/PaulRBerg"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-foundry": "^1.2.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.10",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.0-next.4",
    "@nomicfoundation/hardhat-verify": "^2.0.2",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.11",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "chai": "^4.3.10",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "ethers": "^6.15.0",
    "fs-extra": "^11.3.1",
    "hardhat": "^3.0.0-beta.10",
    "hardhat-deploy": "^0.12.1",
    "hardhat-gas-reporter": "^1.0.9",
    "lodash": "^4.17.21",
    "mocha": "^10.2.0",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.5",
    "solhint": "^6.0.0",
    "solhint-plugin-prettier": "^0.1.0",
    "solidity-coverage": "^0.8.16",
    "ts-generator": "^0.1.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.2"
  },
  "files": [
    "contracts"
  ],
  "keywords": [
    "blockchain",
    "ethers",
    "ethereum",
    "hardhat",
    "smart-contracts",
    "solidity",
    "template",
    "typescript",
    "typechain"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf ./artifacts ./cache ./coverage ./types ./coverage.json && bun run typechain",
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile",
    "coverage": "hardhat coverage --solcoverjs ./.solcover.js --temp artifacts --testfiles \"test/**/*.ts\" && bun run typechain",
    "deploy:hardhat": "hardhat deploy",
    "deploy:foundry": "forge script script/DeployLock.s.sol:DeployLock --rpc-url $NETWORK --sender $SENDER --account $ACCOUNT --broadcast",
    "lint": "bun run lint:sol && bun run lint:ts && bun run format:check",
    "lint:sol": "solhint --max-warnings 0 \"contracts/**/*.sol\"",
    "lint:ts": "eslint .",
    "postcompile": "bun run typechain",
    "format:check": "forge fmt --check && prettier --check \"**/*.{js,json,md,ts,yml}\"",
    "format:write": "forge fmt && prettier --write \"**/*.{js,json,md,ts,yml}\"",
    "prettier:check": "prettier --check \"**/*.{js,json,md,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,ts,yml}\"",
    "task:deployLock": "hardhat task:deployLock",
    "task:withdraw": "hardhat task:withdraw",
    "test:hardhat": "hardhat test",
    "test:foundry": "forge test",
    "typechain": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat typechain"
  }
}
